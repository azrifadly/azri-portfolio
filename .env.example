# Discovery-call booking (app/api/book) — email + .ics via Resend.
# Copy to .env.local for local dev, and set the same vars in Vercel → Project → Settings → Environment Variables.

# Resend API key — https://resend.com → API Keys
RESEND_API_KEY=

# Where booking notifications (with the .ics attachment) are sent. Your Gmail.
OWNER_EMAIL=

# From address. The shared sender below works for testing without a verified
# domain. For production, verify a domain in Resend and use e.g. calls@yourdomain.com
BOOKING_FROM="Discovery calls <onboarding@resend.dev>"
